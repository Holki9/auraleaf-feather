<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_cyber_dialog"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.12"
            android:text="NAVIGATION // FAST JUMP"
            android:textColor="#38BDF8"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:letterSpacing="0.04"
            android:text="ПЕРЕЙТИ К СТРАНИЦЕ"
            android:textColor="#F8FAFC"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_jump_page_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Всего страниц: 1"
            android:textColor="#94A3B8"
            android:textSize="12sp" />

        <!-- Numeric input -->
        <EditText
            android:id="@+id/et_jump_page"
            android:layout_width="140dp"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_cyber_input"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="5"
            android:text="1"
            android:textColor="#38BDF8"
            android:textColorHint="#60FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_jump_cancel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_cyber_button_secondary"
                android:letterSpacing="0.08"
                android:text="ОТМЕНА"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_jump_confirm"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_cyber_button_primary"
                android:letterSpacing="0.08"
                android:text="ПЕРЕЙТИ"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
