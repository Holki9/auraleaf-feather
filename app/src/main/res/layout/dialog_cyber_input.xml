<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_cyber_dialog"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Category HUD tag -->
        <TextView
            android:id="@+id/tv_dialog_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.12"
            android:text="ORGANIZATION // ACTION"
            android:textColor="#38BDF8"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- Title -->
        <TextView
            android:id="@+id/tv_dialog_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="НАЗВАНИЕ ПАПКИ"
            android:textColor="#F8FAFC"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Input Field -->
        <EditText
            android:id="@+id/et_dialog_input"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_cyber_input"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#64748B"
            android:textSize="14sp" />

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="22dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_dialog_cancel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_cyber_button_secondary"
                android:letterSpacing="0.08"
                android:text="ОТМЕНА"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_dialog_confirm"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_cyber_button_primary"
                android:letterSpacing="0.08"
                android:text="СОЗДАТЬ"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
